                  "required": [
                    "page"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
