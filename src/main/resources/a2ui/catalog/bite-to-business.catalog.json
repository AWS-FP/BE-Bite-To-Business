  "LayoutGrid": {
    "type": "object",
    "allOf": [
      {
        "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentCommon"
      },
      {
        "$ref": "#/$defs/CatalogComponentCommon"
      },
      {
        "type": "object",
        "properties": {
          "component": {
            "const": "LayoutGrid"
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/ComponentId"
            },
            "minItems": 1,
            "maxItems": 6
          },
          "layout": {
            "type": "string",
            "enum": [
              "equal",
              "thirds",
              "sidebar-left",
              "sidebar-right"
            ],
            "default": "equal"
          },
          "gap": {
            "type": "string",
            "enum": [
              "small",
              "medium",
              "large"
            ],
            "default": "medium"
          },
          "align": {
            "type": "string",
            "enum": [
              "start",
              "stretch"
            ],
            "default": "start"
          }
        },
        "required": [
          "component",
          "children"
        ]
      }
    ],
    "unevaluatedProperties": false
  },
  "ProductList": {
    "type": "object",
