  "$defs": {
    "CatalogComponentCommon": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "description": "The relative weight of this component within a Row or Column. This is similar to the CSS 'flex-grow' property. Note: this may ONLY be set when the component is a direct descendant of a Row or Column."
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "The primary brand color used for highlights (e.g., primary buttons, active borders). Renderers may generate variants of this color for different contexts. Format: Hexadecimal code (e.g., '#00BFFF').",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "iconUrl": {
          "type": "string",
          "format": "uri",
          "description": "A URL for an image that identifies the agent or tool associated with the surface."
        },
        "agentDisplayName": {
          "type": "string",
          "description": "Text to be displayed next to the surface to identify the agent or tool that created it."
        }
      },
      "additionalProperties": true
    },
    "BtbAction": {
      "description": "Action được phép. FE xử lý; mọi thay đổi giỏ/quote vẫn qua API có kiểm tra quyền.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "const": "view_product"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                    }
                  },
                  "required": [
                    "productId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "const": "add_to_cart"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicString"
                    },
                    "quantity": {
                      "$ref": "https://a2ui.org/specification/v0_9/common_types.json#/$defs/DynamicNumber"
                    }
                  },
                  "required": [
                    "productId"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "const": "refine_search"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "q": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "sort": {
                      "type": "string",
                      "enum": [
                        "name_asc",
                        "name_desc",
                        "newest",
                        "oldest"
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "const": "send_prompt"
                },
                "context": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "required": [
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "context"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "event"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "const": "open_page"
                },
                "context": {
                  "type": "object",
