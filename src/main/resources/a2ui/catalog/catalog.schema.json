{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A2UI Catalog",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "props": { "type": "object" }
        }
      }
    }
  },
  "required": ["version", "components"]
}
